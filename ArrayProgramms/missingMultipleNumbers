import java.util.*;

public class Main {
    public static void main(String[] args) {

        int arr[] = {1, 2, 4, 5, 7, 8, 9};

        Set<Integer> set = new HashSet<>();

        for (int num : arr) {
            set.add(num);
        }
        System.out.println(set);

        for (int i = arr[0]; i <= arr[arr.length - 1]; i++) {
            if (!set.contains(i)) {
                System.out.println(i);
            }
        }
    }
}
