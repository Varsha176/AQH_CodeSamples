Input: arr[] = {1, 2, 0, 4, 3, 0, 5, 0};
Output: arr[] = {1, 2, 4, 3, 5, 0, 0, 0};
-------------------------------------------------------------------------------
class Main {
    public static void main(String[] args) {
        int arr[] = {1, 2, 0, 4, 3, 0, 5, 0};
        moveZeroesToEnd(arr);
        
        for (int num : arr) {
            System.out.print(num + " ");
        }
    }

    static void moveZeroesToEnd(int[] arr) {
        int n = arr.length;
        int insertPos = 0; // tracks position to place the next non-zero element

        // Step 1: Move all non-zero elements to the front, preserving order
        for (int i = 0; i < n; i++) {
            if (arr[i] != 0) {
                arr[insertPos] = arr[i];
                insertPos++;
            }
        }

        // Step 2: Fill the remaining positions with zero
        while (insertPos < n) {
            arr[insertPos] = 0;
            insertPos++;
        }
    }
}
