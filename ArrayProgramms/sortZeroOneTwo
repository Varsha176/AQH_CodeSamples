import java.util.Arrays;
class Main {
    public static void main(String[] args) {
        int arr[] = {1,0,2,0,2,1,1};
        int low = 0;
        int mid = 0;
        int high = arr.length-1;
        while(mid<=high)
            {
                if(arr[mid]==0)
                {
                    swap(arr,low,mid);
                    low++;
                    mid++;
                }
                else if(arr[mid]==1)
                {
                    mid++;
                }
                else
                {
                    swap(arr,mid,high);
                    high--;
                }
            }
        System.out.print(Arrays.toString(arr));
    }

    public static void swap(int arr[],int x, int y)
    {
        int temp =  arr[x];
        arr [x] = arr[y];
        arr[y] = temp;
    }
}
