Q: Check if strings are rotaion for each other
logic: concat string with itself, The doubled string contains every possible rotation of the original string.

public class RotationCheck {

    public static boolean isRotation(String str1, String str2) {

        if (str1 == null || str2 == null)
            return false;

        if (str1.length() != str2.length())
            return false;

        String temp = str1 + str1;

        return temp.contains(str2);
    }

    public static void main(String[] args) {

        System.out.println(isRotation("ABCD", "CDAB"));
        System.out.println(isRotation("waterbottle", "erbottlewat"));
        System.out.println(isRotation("ABCD", "ACBD"));
    }
}
