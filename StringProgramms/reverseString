import java.util.Scanner;

class NeonNumber {
    public static void main(String[] args) {
        String str = "GeeksforGeeks";
        char newstr[] = str.toLowerCase().toCharArray();
        char temp;
        for(int i=0;i<str.length();i++)
        {
            for(int j=i+1;j<str.length();j++)
            {
                if(newstr[i]>newstr[j])
                {
                    temp = newstr[i];
                    newstr[i] = newstr[j];
                    newstr[j] =temp;
                }
            }
        }
        for(char c: newstr)
        {
            System.out.print(c);
        }
    
    }
}
